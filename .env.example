# Copy to .env and adjust. NEVER commit .env or real credentials.

# ---- Backend ----
APP_NAME=ViewBox Panel System
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mock OTP (development only) - displayed on screen and returned by the API
MOCK_OTP=123456
OTP_EXPIRY_MINUTES=10

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=viewbox
POSTGRES_USER=viewbox
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://viewbox:change-me-locally@localhost:5432/viewbox

# ---- Test database (SQLite in-memory for fast unit/integration tests) ----
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
